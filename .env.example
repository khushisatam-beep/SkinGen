# Copy to .env and change the placeholders. NEVER commit .env.
# If the password has special characters (@ : / ?), URL-encode them (the compose file builds MONGODB_URI from it).
MONGO_ROOT_USERNAME=skingen_admin
MONGO_ROOT_PASSWORD=change_me_please
MONGO_DB_NAME=skingen

# Optional history (stores model scores only; see README "Privacy")
ENABLE_HISTORY=true
STORE_INPUTS=false
HISTORY_TTL_DAYS=30

NODE_PORT=5000
ML_PORT=8001
# Empty = CORS disabled. Later set to your frontend origin, e.g. http://localhost:3000
CORS_ORIGIN=

# Protects GET /api/v1/history (send as header  X-API-Key: <key>). Empty = that endpoint is disabled.
# Generate one with:  openssl rand -hex 32
ADMIN_API_KEY=
# Max /assess calls per IP per minute (0 = off). Set TRUST_PROXY=1 when running behind nginx / a load balancer.
RATE_LIMIT_PER_MIN=60
TRUST_PROXY=
# Storing is OFF for an individual request unless it sends consentToStore:true.
# Set ENABLE_HISTORY=false to disable MongoDB history completely.
# Set STORE_INPUTS=true only if storing questionnaire/red-flag/family-history answers is necessary.

